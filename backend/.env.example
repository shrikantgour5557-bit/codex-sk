# Copy to .env (never commit .env). Put your Gemini key only in backend/.env.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# After loading the extension, copy its exact chrome-extension:// ID here.
EXTENSION_ORIGINS=chrome-extension://replace-with-extension-id
RATE_LIMIT_MAX=20
PROVIDER_TIMEOUT_MS=35000
HOST=127.0.0.1
PORT=8787
